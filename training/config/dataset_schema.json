{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zoe-sft-example.schema.json",
  "title": "ZoeSFTExample",
  "type": "object",
  "required": ["id", "messages", "metadata"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "additionalProperties": false,
        "properties": {
          "role": { "enum": ["system", "user", "assistant"] },
          "content": { "type": "string", "minLength": 1 }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["category"],
      "properties": {
        "category": {
          "enum": [
            "general_conversation",
            "personality",
            "tool_routing",
            "agent_planning",
            "memory",
            "retrieval_rag",
            "coding",
            "project_analysis",
            "structured_output",
            "error_handling"
          ]
        },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "source": { "type": "string" },
        "quality": { "type": "number", "minimum": 0, "maximum": 1 },
        "personality_mode": {
          "enum": [
            "professional_neutral",
            "lightly_witty",
            "playful_sarcastic",
            "serious_no_humor"
          ]
        },
        "personality_required": { "type": "boolean" },
        "tool_required": { "type": "boolean" },
        "expected_behavior": { "type": "string" },
        "safety_sensitive": { "type": "boolean" },
        "extra": { "type": "object" }
      },
      "additionalProperties": true
    }
  }
}
